<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <AssemblyName>GhostClip</AssemblyName>
    <Product>GhostClip</Product>
    <Authors>ZeroFlagLabs</Authors>
    <Company>ZeroFlagLabs</Company>
    <Description>Temporary in-memory screenshot copying for Windows.</Description>
    <RepositoryUrl>https://github.com/ZeroFlagLabs/ghostclip</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 ZeroFlagLabs</Copyright>
  </PropertyGroup>

  <!-- The native colour dialog is called explicitly. Do not inject WinForms
       global usings into the existing WPF application. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
