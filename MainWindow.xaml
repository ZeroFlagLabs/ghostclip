<Window x:Class="GhostClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GhostClip"
        SizeToContent="Width"
        Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <CornerRadius x:Key="GhostButtonCornerRadius">6</CornerRadius>
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource GhostButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetBorder"
            CornerRadius="8"
            Background="#F0222222"
            BorderBrush="#454545"
            BorderThickness="1"
            Padding="7,4">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Canvas x:Name="GhostIconContainer"
                    Grid.Column="0"
                    Width="19" Height="20"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    ToolTip="GhostClip"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Path x:Name="GhostIconShape"
                      Data="M 2,19 L 2,9 C 2,4 5.5,1 9.5,1 C 13.5,1 17,4 17,9 L 17,19 L 13.5,16 L 9.5,19 L 5.5,16 Z"
                      Fill="White"/>
                <Ellipse Width="2.6" Height="3" Fill="#20242C"
                         Canvas.Left="5.4" Canvas.Top="8"/>
                <Ellipse Width="2.6" Height="3" Fill="#20242C"
                         Canvas.Left="11" Canvas.Top="8"/>
            </Canvas>

            <TextBlock x:Name="DragArea"
                       Grid.Column="1"
                       Text="GhostClip"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,9,0"
                       ToolTip="Unlock the widget in Settings to reposition it"
                       MouseLeftButtonDown="DragArea_MouseLeftButtonDown"/>

            <TextBlock x:Name="CompactDragHandle"
                       Grid.Column="1"
                       Text="⠿"
                       FontSize="16"
                       Foreground="#BFC4CB"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Visibility="Collapsed"
                       ToolTip="Drag GhostClip"
                       MouseLeftButtonDown="DragArea_MouseLeftButtonDown"/>

            <Button x:Name="PrivacyButton"
                    Grid.Column="2"
                    Content="PRIVATE OFF"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Width="91"
                    Margin="0,0,3,0"
                    Click="PrivacyButton_Click"/>

            <Button x:Name="StatusButton"
                    Grid.Column="3"
                    Content="OFF"
                    Style="{StaticResource GhostButtonStyle}"
                    Background="#303030"
                    Width="91"
                    HorizontalAlignment="Stretch"
                    Margin="3,0,0,0"
                    ToolTip="Capture a private snip"
                    Click="StatusButton_Click"/>

            <Button x:Name="SettingsButton"
                    Grid.Column="4"
                    Content="⚙"
                    FontFamily="Segoe UI Symbol"
                    FontSize="15"
                    Style="{StaticResource GhostButtonStyle}"
                    Background="#303030"
                    Width="30"
                    Padding="0"
                    Margin="5,0,0,0"
                    ToolTip="GhostClip settings"
                    Click="SettingsButton_Click"/>

            <Button x:Name="ExitButton"
                    Grid.Column="5"
                    Style="{StaticResource GhostButtonStyle}"
                    Background="#443035"
                    Width="30"
                    Padding="0"
                    Margin="5,0,0,0"
                    ToolTip="Exit GhostClip"
                    AutomationProperties.Name="Exit GhostClip"
                    Click="ExitButton_Click">
                <Path x:Name="ExitCross" Data="M 2,2 L 12,12 M 12,2 L 2,12"
                      Width="10" Height="10"
                      Stroke="White"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</Window>