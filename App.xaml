<Application x:Class="GhostClip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GhostClip"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- The WPF source of GhostClip's ghost artwork. Regenerate the
             executable icon using scripts/Generate-Icon.ps1 when edited. -->
        <DrawingImage x:Key="GhostClipWindowIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#242830">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="6" RadiusY="6"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F7FAFE">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 7,25 L 7,14 C 7,8 11,5 16,5 C 21,5 25,8 25,14 L 25,25 L 21,22 L 16,25 L 11,22 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#242830">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,14" RadiusX="1.65" RadiusY="1.95"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#242830">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="20,14" RadiusX="1.65" RadiusY="1.95"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
